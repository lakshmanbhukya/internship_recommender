# Upload internships_cleaned.csv before running

# Install dependencies
!pip install sentence-transformers pandas numpy -q

import pandas as pd
import numpy as np
from sentence_transformers import SentenceTransformer
from datetime import datetime
import os

print("🚀 Starting embedding generation...")

# Upload CSV file
from google.colab import files
print("📤 Please upload internships_cleaned.csv")
uploaded = files.upload()

# Load data
df = pd.read_csv('internships_cleaned.csv')
print(f"📊 Loaded {len(df)} internships")

# Load model on GPU
print("🔄 Loading BGE-M3 model on T4 GPU...")
model = SentenceTransformer('BAAI/bge-m3', device='cuda')
print(f"✅ Model loaded on: {model.device}")

# Generate embeddings
print("🧠 Generating embeddings...")
start_time = datetime.now()

embeddings = model.encode(
    df['embedding_text'].tolist(),
    batch_size=64,
    show_progress_bar=True,
    normalize_embeddings=True,
    convert_to_numpy=True
)

elapsed = (datetime.now() - start_time).total_seconds()
print(f"✅ Generated in {elapsed:.2f}s")
print(f"📊 Shape: {embeddings.shape}")

# Sanity check
from sklearn.metrics.pairwise import cosine_similarity
test_sim = cosine_similarity(embeddings[:3])
print(f"🔍 Sample similarities:\n{np.round(test_sim, 3)}")

# Save embeddings
np.save('internship_embeddings.npy', embeddings)
print("💾 Saved: internship_embeddings.npy")

# Save metadata
metadata_cols = [
    'internship_id', 'profile', 'company', 'Location', 'location_normalized',
    'stipend_min', 'stipend_max', 'duration_months', 'education_normalized',
    'skills_clean', 'Perks', 'Apply by Date', 'freshness_score'
]
df[metadata_cols].to_csv('internship_metadata.csv', index=False)
print("💾 Saved: internship_metadata.csv")

# Download files
print("\n📥 Downloading files...")
files.download('internship_embeddings.npy')
files.download('internship_metadata.csv')

print("\n✅✅✅ COMPLETE! ✅✅✅")
print("Next: Run database/create_database.py")
